MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
PORT=4000
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
FRONTEND_URL=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shiprocket (logistics/shipping)
# 1. Login to your Shiprocket seller panel
# 2. Settings > API > Configure > Create API User
# 3. Use the API user email + password below (NOT your main login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Name of the pickup location you configured in Shiprocket (e.g. "Primary")
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: Generate a strong random token. Paste this into Shiprocket's
# Settings > API > Webhooks > "Security Token" field so your backend can
# validate that inbound webhook events really came from Shiprocket.
SHIPROCKET_WEBHOOK_SECRET=replace_with_strong_random_string
